<wpml-config>
    <custom-types>
        <custom-type translate="0">tp_posttypes</custom-type>
        <custom-type translate="1">dynamic_template</custom-type>
    </custom-types>

    <custom-fields>
        <custom-field action="translate">dynamic_meta</custom-field>
    </custom-fields>

    <gutenberg-blocks>
        <gutenberg-block type="greyd/dynamic" translate="1">
            <key name="dynamic_content">
                <key name="*">
                    <key name="dvalue" />
                </key>
            </key>
        </gutenberg-block>
        <gutenberg-block type="greyd/accordion-item" translate="1">
            <xpath>//button[@class="wp-block-greyd-accordion__title"]/span</xpath>
            <key name="title" />
        </gutenberg-block>
        <gutenberg-block type="greyd/button" translate="1">
            <key name="content" />
        </gutenberg-block>
        <gutenberg-block type="greyd/image" translate="1">
            <key name="caption" />
            <key name="downloadLink">
                <key name="text" />
            </key>
        </gutenberg-block>
        <gutenberg-block type="greyd/list-item" translate="1">
            <key name="content" />
        </gutenberg-block>
        <gutenberg-block type="greyd/popover" translate="1">
            <key name="content" />
        </gutenberg-block>
        <gutenberg-block type="greyd/search-input" translate="1">
            <key name="label" />
            <key name="placeholder" />
        </gutenberg-block>
        <gutenberg-block type="greyd/search-submit" translate="1">
            <key name="content" />
        </gutenberg-block>
        <gutenberg-block type="greyd/search-filter" translate="1">
            <key name="label" />
            <key name="placeholder" />
        </gutenberg-block>
        <gutenberg-block type="greyd/search-sorting" translate="1">
            <key name="label" />
            <key name="placeholder" />
        </gutenberg-block>
        <gutenberg-block type="greyd/tab" translate="1">
            <key name="title" />
        </gutenberg-block>
    </gutenberg-blocks>
</wpml-config>